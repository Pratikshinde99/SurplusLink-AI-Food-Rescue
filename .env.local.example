# Development Environment - Copy to .env.local and adjust values
# NOTE: This is for LOCAL DEVELOPMENT ONLY. Use different values for production.

# ─── Frontend Configuration ───────────────────────────────
# Local API server
VITE_API_URL=http://localhost:8000

# Supabase Configuration (Optional - set up if using Supabase)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ─── Feature Flags ────────────────────────────────────────
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_AI_SCORING=true

# ─── Backend Configuration ────────────────────────────────
ENVIRONMENT=development

# API Port
PORT=8000

# CORS - Allow localhost for development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ─── Google Gemini AI (Required for AI scoring) ──────────
# Get your API key from: https://console.cloud.google.com/
# 1. Create a new project
# 2. Enable Generative AI API
# 3. Create an API key
# 4. Paste it below
GEMINI_API_KEY=paste_your_gemini_api_key_here

# ─── Supabase (Optional - for future database integration) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── JWT Configuration (Optional - for future authentication) ──
# In production, use a strong random secret
JWT_SECRET=your-dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Rate Limiting ────────────────────────────────────────
# Requests per minute
RATE_LIMIT_PER_MINUTE=60
